# Copy to .env and fill in. .env is gitignored.

DATASOURCE_URL=jdbc:postgresql://localhost:5432/ice-cream
DATASOURCE_PASSWORD=spring

# Must be Base64 and at least 256 bits: openssl rand -base64 48
JWT_SECRET=

# Dev points at Mailpit, which accepts anything. Prod needs a Gmail App Password.
MAIL_USERNAME=dev@localhost
MAIL_PASSWORD=unused-in-dev

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
