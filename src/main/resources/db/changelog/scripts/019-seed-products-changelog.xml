<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- The three flavours are reference data for this shop, not user content:
         the storefront's artwork and accent colours are keyed to these slugs,
         so an empty catalog is a broken deployment rather than an empty one.
         Each insert is skipped where the slug already exists, so running this
         against a database that was seeded by hand changes nothing. Stock is a
         starting figure; the nightly restock job takes it from here. -->

    <changeSet id="01-banana" author="daniel">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM product WHERE slug = 'banana'
            </sqlCheck>
        </preConditions>

        <insert tableName="product">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="slug" value="banana"/>
            <column name="name" value="NANO BANANA"/>
            <column name="price" valueNumeric="8.99"/>
            <column name="stock_quantity" valueNumeric="100"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="02-chocolate" author="daniel">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM product WHERE slug = 'chocolate'
            </sqlCheck>
        </preConditions>

        <insert tableName="product">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="slug" value="chocolate"/>
            <column name="name" value="NANO CHOCOLATE"/>
            <column name="price" valueNumeric="9.49"/>
            <column name="stock_quantity" valueNumeric="100"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="03-strawberry" author="daniel">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM product WHERE slug = 'strawberry'
            </sqlCheck>
        </preConditions>

        <insert tableName="product">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="slug" value="strawberry"/>
            <column name="name" value="NANO STRAWBERRY"/>
            <column name="price" valueNumeric="8.99"/>
            <column name="stock_quantity" valueNumeric="100"/>
            <column name="active" valueBoolean="true"/>
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
    </changeSet>
</databaseChangeLog>
